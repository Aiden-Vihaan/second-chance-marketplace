{
  "openapi": "3.0.0",
  "info": {
    "title": "Second Chance Marketplace API",
    "description": "REST API for the Second Chance Marketplace platform.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:5000/api",
      "description": "Development Server"
    }
  ],
  "tags": [
    {
      "name": "Authentication"
    },
    {
      "name": "Items"
    },
    {
      "name": "Wishlist"
    },
    {
      "name": "Reviews"
    },
    {
      "name": "Admin"
    }
  ],
  "paths": {
    "/auth/register": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Register a new user",
        "responses": {
          "201": {
            "description": "User registered successfully"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Login user",
        "responses": {
          "200": {
            "description": "Login successful"
          }
        }
      }
    },
    "/items": {
      "get": {
        "tags": ["Items"],
        "summary": "Get all marketplace items",
        "responses": {
          "200": {
            "description": "List of items"
          }
        }
      },
      "post": {
        "tags": ["Items"],
        "summary": "Create a new item",
        "responses": {
          "201": {
            "description": "Item created successfully"
          }
        }
      }
    },
    "/wishlist": {
      "get": {
        "tags": ["Wishlist"],
        "summary": "Get user wishlist",
        "responses": {
          "200": {
            "description": "Wishlist retrieved"
          }
        }
      }
    }
  }
}
